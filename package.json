{
  "name": "stackhacker-ui-chat",
  "description": "Full-featured AI chatbot template built with Nuxt, shadcn-vue, and AI SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stackhacker-ui/chat.git"
  },
  "homepage": "https://chat-template.stackhacker.io",
  "bugs": {
    "url": "https://github.com/stackhacker-ui/chat/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate",
    "deploy": "NITRO_PRESET=cloudflare-module nuxt build && wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json && wrangler --cwd .output deploy",
    "deploy:preview": "NITRO_PRESET=cloudflare-module CLOUDFLARE_ENV=preview nuxt build && wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json --env preview && wrangler --cwd .output deploy --env preview"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.133",
    "@ai-sdk/vue": "^3.0.208",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.87",
    "@libsql/client": "^0.17.4",
    "@nuxt/icon": "^2.2.3",
    "@nuxthub/core": "^0.10.7",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/mdc": "^0.22.0",
    "@vercel/blob": "^2.4.1",
    "@vueuse/core": "^14.3.0",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-vue-next": "^0.577.0",
    "motion-v": "^1.10.3",
    "nuxt": "^4.4.4",
    "nuxt-auth-utils": "^0.5.29",
    "nuxt-charts": "^2.1.4",
    "pg": "^8.22.0",
    "reka-ui": "^2.10.0",
    "shadcn-nuxt": "^2.7.4",
    "shiki": "^3.23.0",
    "shiki-stream": "^0.1.5",
    "striptags": "3.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.5",
    "wrangler": "^4.103.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.5",
      "defu": "^6.1.7",
      "esbuild": "^0.28.1",
      "picomatch": "^4.0.4"
    }
  },
  "packageManager": "pnpm@10.34.4"
}
