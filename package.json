{
  "name": "stackhacker-ui-chat",
  "description": "Full-featured AI chatbot template built with Nuxt, shadcn-vue, and AI SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stackhacker-ui/chat.git"
  },
  "homepage": "https://chat-template.stackhacker.io",
  "bugs": {
    "url": "https://github.com/stackhacker-ui/chat/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate",
    "deploy": "NITRO_PRESET=cloudflare-module nuxt build && wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json && wrangler --cwd .output deploy",
    "deploy:preview": "NITRO_PRESET=cloudflare-module CLOUDFLARE_ENV=preview nuxt build && wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json --env preview && wrangler --cwd .output deploy --env preview"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.165",
    "@ai-sdk/vue": "^3.0.244",
    "@iconify-json/logos": "^1.2.12",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/simple-icons": "^1.2.93",
    "@libsql/client": "^0.17.4",
    "@nuxt/icon": "^2.4.1",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/mdc": "^0.22.2",
    "@vercel/blob": "^2.6.1",
    "@vueuse/core": "^14.4.0",
    "ai": "^6.0.244",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-vue-next": "^0.577.0",
    "motion-v": "^1.10.3",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "nuxt-charts": "^2.2.0",
    "pg": "^8.22.0",
    "reka-ui": "^2.9.0",
    "shadcn-nuxt": "^2.4.3",
    "shiki": "^3.23.0",
    "shiki-stream": "^0.1.4",
    "striptags": "3.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.86.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
